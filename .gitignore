# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# editor
.vscode/

# typescript
*.tsbuildinfo
next-env.d.ts

# docker — Postgres data directories (dev and prod use separate paths, real
# data once migrated) and migration secrets/mapping output must never be committed
docker/volumes/db/data/
docker/volumes/db/data-prod/
docker/volumes/db/data-prod.bak-*/
docker/scripts/migrate-data/auth-id-mapping.json
docker/*.dump
docker/SERVICE_CREDENTIALS.md
docker/.env.local-vps-backend

# investor material — pitch decks, business plans and their exports. Kept out
# of the repo because they carry unaudited projections and round figures that
# shouldn't travel with the code. docs/DEVELOPER_GUIDE.html and the migration
# notes stay tracked; these do not.
docs/*.pptx
docs/*.potx
docs/*.pdf
docs/investment-deck.html
docs/Shei-Hoise-*
/PawfectBD Business Tracker.xlsx
